function hvcMediaBlob_(jenis) {
  const base64 = jenis === 'kop' ? HVC_MEDIA_KOP_B64 : HVC_MEDIA_FOOTER_B64;
  const nama = jenis === 'kop' ? 'KOP_HVC_TEMPLATE_CROP.png' : 'ORNAMEN_BAWAH_TEMPLATE_ASLI.png';
  return Utilities.newBlob(Utilities.base64Decode(base64),'image/png',nama);
}
